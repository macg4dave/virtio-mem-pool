# Example site file for the Windows make targets (make windows-build,
# windows-gate, windows-status, windows-deploy). Copy it to
# site/windows-build.mk (untracked) or point WINDOWS_SITE at another file.
# Every value can also be set on the make command line or in the environment.

# SSH alias in ~/.ssh/config (address, user, identity and host key live there).
WINDOWS_SSH ?= windows-build-vm
# Checkout inside the guest that sources are synced to and built in.
WINDOWS_DIR ?= C:\build\rampire
# Local folder for fetched binaries, build records and deploy evidence.
WINDOWS_ARTIFACTS ?= .artifacts/windows/windows-vm
# Seconds to wait for SSH to connect, and for each remote step to finish.
WINDOWS_CONNECT_TIMEOUT_SECONDS ?= 10
WINDOWS_OPERATION_TIMEOUT_SECONDS ?= 1200
# The VM settings file deployed by make windows-deploy.
WINDOWS_MANIFEST ?= site/vms.d/windows-vm.toml
# Installed Windows service name.
WINDOWS_SERVICE ?= RampireGuest
