# Example site file for tools/gate.sh. Copy it to site/gate.env (untracked).
# SSH destination of a Linux build host with Rust installed.
RAMPIRE_GATE_HOST=linux-build-host
# Absolute directory on that host that the gate owns: src/ is replaced on
# every run and target/ keeps Cargo's output between runs.
RAMPIRE_GATE_DIR=/var/tmp/rampire-gate
# SSH client, if not the first ssh on PATH.
# RAMPIRE_SSH=/c/Windows/System32/OpenSSH/ssh.exe
