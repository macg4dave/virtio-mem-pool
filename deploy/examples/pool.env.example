# Example site file for tools/windows/Watch-Pool.ps1. Copy it to
# site/pool.env (untracked).
# SSH destination of the KVM host that runs the controller.
VIRTIO_MEM_POOL_HOST=kvm-host
# This repository's checkout on that host; ~/ is the SSH user's home.
VIRTIO_MEM_POOL_CHECKOUT=~/src/virtio-mem-pool
# Host list the controller runs, if not the installed one.
# VIRTIO_MEM_POOL_CONFIG=/etc/virtio-mem-host/host_list.toml
