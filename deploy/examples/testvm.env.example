# Example site file for `cargo xtask testvm`. Copy it to site/testvm.env
# (untracked) on the KVM host and load it before a run:
#   set -a; . site/testvm.env; set +a
#   sudo -E target/debug/xtask testvm up tools/testvm/SCENARIO.toml --name NAME ...
# Absolute folder for test VMs' disks and seeds; downloaded images are kept
# in its testvm-cache/ folder.
RAMPIRE_TESTVM_IMAGES=/var/lib/libvirt/images
# Host bridge the test VMs join; they need DHCP and a route to their
# distribution's package mirrors.
RAMPIRE_TESTVM_BRIDGE=br0
# Optional public key for the VMs' user "tester".
# RAMPIRE_TESTVM_SSH_KEY=/root/.ssh/id_ed25519.pub
