[Unit]
Description=RAMpire memory controller for %i
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=exec
User=rampire
Group=rampire
# Access the dedicated libvirt-managed virtio-serial socket.
SupplementaryGroups=qemu
# Provision non-interactive libvirt management authorization for this account
# during installation. The daemon checks it before polling and never requests
# a desktop password dialog or elevates itself. The libvirt connection is
# libvirt_uri in global.toml.
Environment=HOME=/run/rampire
Environment=XDG_CACHE_HOME=/run/rampire/.cache
# A site with another layout overrides ExecStart in a drop-in
# (systemctl edit rampire@.service). The configuration directory holds
# global.toml, vms.d/ and attestations/; durable state goes in the
# StateDirectory below.
ExecStart=/usr/local/bin/rampire --config /etc/rampire
# Failure is fail-stop. Deployment monitoring decides when a reviewed restart
# is appropriate; the unit does not create an automatic restart loop.
Restart=no
# Inherit the host manager's configured stop timeout rather than embedding a
# test-derived deadline in the repository unit.
# Readable by host tools: it holds each guest's latest publication
# (<vm_name>.publication.json). UMask keeps everything else in it private.
RuntimeDirectory=rampire
RuntimeDirectoryMode=0755
StateDirectory=rampire/state
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
