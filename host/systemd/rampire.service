[Unit]
Description=RAMpire memory controller
Documentation=https://github.com/macg4dave/rampire
# libvirt runs as one daemon (libvirtd) or as split daemons (virtqemud,
# usually socket-activated): order after whichever this host has. After=
# a unit that isn't installed is ignored.
After=network-online.target libvirtd.service virtqemud.service virtqemud.socket
Wants=network-online.target

[Service]
Type=exec
User=rampire
Group=rampire
# Access the dedicated libvirt-managed virtio-serial socket.
SupplementaryGroups=qemu
# Provision non-interactive libvirt management authorization for this account
# during installation. The daemon checks it before polling and never requests
# a desktop password dialog or elevates itself. The libvirt connection is
# libvirt_uri in global.toml.
Environment=HOME=/run/rampire
Environment=XDG_CACHE_HOME=/run/rampire/.cache
# The controller runs only the copy `rampire apply` checked (decision D10),
# never the draft in /etc/rampire: a mistake there can't reach it, through
# a restart or a reboot. The copy holds global.toml, vms.d/ and
# attestations/; durable state goes in the StateDirectory below.
ExecStart=/usr/local/bin/rampire daemon --config /var/lib/rampire/applied/current
# Failure is fail-stop. Deployment monitoring decides when a reviewed restart
# is appropriate; the unit does not create an automatic restart loop.
Restart=no
# Inherit the host manager's configured stop timeout rather than embedding a
# test-derived deadline in the repository unit.
# Holds each guest's latest publication (<vm_name>.publication.json) for
# `rampire top` and `watch`, which run as root (decision D14), so it is
# private to the service account and root.
RuntimeDirectory=rampire
RuntimeDirectoryMode=0750
StateDirectory=rampire/state
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
