[Unit]
Description=RAMpire guest memory requests
Documentation=https://github.com/macg4dave/rampire
# Without the control channel the host exchanges the control files through
# the guest agent instead.
After=qemu-guest-agent.service
ConditionVirtualization=kvm

[Service]
Type=exec
ExecStart=/usr/local/libexec/rampire-guest run
# The control channel to the host. systemd opens it and hands the service the
# descriptor, so the unprivileged service needs no device access. "graceful":
# a VM without the port starts the service anyway, on the control files.
OpenFile=/dev/virtio-ports/org.virtio-mem.control.0:control:graceful
# When the guest runs out of memory this service is what asks for more, so
# it must be among the last processes the kernel kills. On 2026-11-13 a
# fast fill killed it and the guest could never grow again.
OOMScoreAdjust=-900
# A restart is safe: the one unresolved request is durable in the state
# directory and is retransmitted unchanged until the host resolves it.
Restart=on-failure
RestartSec=5
# Unprivileged: the service only reads /proc and writes its state directory.
# On the control files the guest agent (root) reads the publication and
# writes the host status beside it, so the directory and its files stay
# readable.
DynamicUser=yes
StateDirectory=rampire-guest
StateDirectoryMode=0755
UMask=0022
# The kernel serves memory-pressure triggers with windows shorter than two
# seconds only to a process holding CAP_SYS_RESOURCE. Without it the service
# still runs, on two-second windows. It holds no other capability.
AmbientCapabilities=CAP_SYS_RESOURCE
CapabilityBoundingSet=CAP_SYS_RESOURCE
# Sandbox, reviewed 2026-11-13 with the transport final (T4.4). The service
# reads /proc/meminfo, /proc/vmstat, /proc/pressure/memory (and writes its
# trigger there), /sys memory-hotplug facts and its state directory, and
# talks to the host only over the descriptor systemd opens for it.
# Not set, deliberately: PrivateUsers= would confine CAP_SYS_RESOURCE to a
# user namespace, where the kernel's pressure-trigger check does not see it;
# ProcSubset=pid would hide /proc/meminfo and /proc/pressure;
# PrivateDevices= would stop OpenFile= above: systemd opens the port inside
# the private /dev, where it does not exist, and "graceful" then silently
# leaves the service on the control files (found on a live guest with the
# port, 2026-11-13). The device policy below keeps the same lockdown and
# allows only the virtio console ports for that open.
DevicePolicy=closed
DeviceAllow=char-virtio-portsdev rw
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateNetwork=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
