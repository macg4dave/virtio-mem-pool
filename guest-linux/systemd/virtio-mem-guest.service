[Unit]
Description=Virtio-mem guest memory requests
Documentation=https://github.com/macg4dave/virtio-mem-pool
# Without the control channel the host exchanges the control files through
# the guest agent instead.
After=qemu-guest-agent.service
ConditionVirtualization=kvm

[Service]
Type=exec
ExecStart=/usr/local/libexec/virtio-mem-guest run
# The control channel to the host. systemd opens it and hands the service the
# descriptor, so the unprivileged service needs no device access. "graceful":
# a VM without the port starts the service anyway, on the control files.
OpenFile=/dev/virtio-ports/org.virtio-mem.control.0:control:graceful
# When the guest runs out of memory this service is what asks for more, so
# it must be among the last processes the kernel kills. On 2026-11-13 a
# fast fill killed it and the guest could never grow again.
OOMScoreAdjust=-900
# A restart is safe: the one unresolved request is durable in the state
# directory and is retransmitted unchanged until the host resolves it.
Restart=on-failure
RestartSec=5
# Unprivileged: the service only reads /proc and writes its state directory.
# On the control files the guest agent (root) reads the publication and
# writes the host status beside it, so the directory and its files stay
# readable.
DynamicUser=yes
StateDirectory=virtio-mem-guest
StateDirectoryMode=0755
UMask=0022
# The kernel serves memory-pressure triggers with windows shorter than two
# seconds only to a process holding CAP_SYS_RESOURCE. Without it the service
# still runs, on two-second windows. It holds no other capability.
AmbientCapabilities=CAP_SYS_RESOURCE
CapabilityBoundingSet=CAP_SYS_RESOURCE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
